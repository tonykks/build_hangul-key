rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'kwangsoo60kim@gmail.com' ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*admin.*'))
      );
    }

    function isValidUser(data) {
      return data.uid is string &&
             data.uid == request.auth.uid &&
             data.nickname is string &&
             data.nickname.size() > 0 &&
             data.nickname.size() <= 50 &&
             data.displayName is string &&
             data.displayName.size() > 0 &&
             data.displayName.size() <= 60 &&
             data.totalPracticeSeconds is number &&
             data.totalPracticeSeconds >= 0;
    }

    function isValidPracticeLog(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.userDisplay is string &&
             data.userDisplay.size() > 0 &&
             data.userDisplay.size() <= 60 &&
             data.durationSeconds is number &&
             data.durationSeconds >= 0;
    }

    // Users collection (User profile & cumulative practice stats)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUser(request.resource.data);
      allow update: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin()) && isValidUser(request.resource.data);
      allow delete: if isAdmin();
    }

    // Practice logs collection
    match /practice_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(logId) && isValidPracticeLog(request.resource.data);
      allow update, delete: if isAdmin();
    }
  }
}
